#!/usr/bin/env python3
"""skirt —— YojigenOS 构建驱动

短裙里装着四次元空间；这里装着所有的包。

用法:
    skirt/skirt build <包名>              构建一个包（默认当前架构）
    skirt/skirt build --arch x86_64 <包名>
    skirt/skirt list                      列出所有包
    skirt/skirt deps <包名>               查看依赖解析结果（不构建）
    skirt/skirt stale [包名…]             哪些包该重建（比 build_key，退出码 0=该重建）
    skirt/skirt restore [--arch x86_64]   把 var/pkgs 里的 .apk 还原成 payload
    skirt/skirt clean [包名]              清理构建目录 / 该包的产物

依赖机制:
    构建一个包之前，驱动会：
      1. 递归解析它的 runtime + build 依赖（按依赖顺序排好）
      2. 把 bootstrap/provides.txt 里列出的包视为「构建环境已提供」，跳过
      3. 其余依赖必须已经在 var/output/<架构>/ 里构建过
      4. 把它们的 payload 叠加成 sysroot，合并进构建容器的根文件系统

    bootstrap/provides.txt 是「构建环境基线」，不是待办清单。它永远不会空——
    glibc 构建需要 make，make 运行需要 glibc，这个环是内在的。真正的自举
    标志是：基线里的东西是我们自己构建的，且构建环境是我们自己搭的。

这个文件只是入口。实现在 skirtlib/ 里按职责分开：
    common.py    路径常量、日志、哈希、架构名
    spec.py      配方加载与变量展开
    deps.py      宿主基线、依赖闭包、sysroot 叠加
    source.py    下载、校验、解压
    build.py     构建脚本生成、容器内执行
    collect.py   产物收集与 meta.json
    buildkey.py  一个包的身份 —— 从内容算出来（见 docs/约定/客观性.md）
    commands.py  子命令

首次使用前需要准备构建环境:
    docker build -t yojigen/buildenv:$(uname -m | sed 's/arm64/aarch64/') bootstrap
"""

from __future__ import annotations

import os
import sys
from pathlib import Path

# 允许直接以脚本方式运行（./skirt/skirt），无需安装
sys.path.insert(0, str(Path(__file__).resolve().parent))

from skirtlib.commands import main

if __name__ == "__main__":
    try:
        main()
    except BrokenPipeError:
        # 输出被下游截断（例如 `skirt build x | head`）。构建本身往往还在
        # 正常进行，不该为此抛一个看不懂的 traceback。
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        sys.exit(0)
