#!/usr/bin/env python3
"""skirt —— YojigenOS 构建驱动

短裙里装着四次元空间；这里装着所有的包。

用法:
    tools/skirt build <包名>              构建一个包（默认当前架构）
    tools/skirt build --arch x86_64 <包名>
    tools/skirt list                      列出所有包
    tools/skirt deps <包名>               查看依赖解析结果（不构建）
    tools/skirt clean [包名]              清理构建目录 / 该包的产物

依赖机制:
    构建一个包之前，驱动会:
      1. 递归解析它的 depends + build_depends（按依赖顺序排好）
      2. 把 host/provides.txt 里列出的包视为「宿主已提供」，跳过
      3. 其余依赖必须已经在 output/<架构>/ 里构建过
      4. 把它们的 payload 叠加成 sysroot，合并进构建容器的根文件系统

    host/provides.txt 就是「距离自举成功还有多远」的度量——
    每当你用 YojigenOS 自己构建出一个包，就把它从那份列表里删掉。
    列表清空的那天 = self-hosting 成功。

首次使用前需要准备构建环境:
    docker build -t yojigen/buildenv:$(uname -m | sed 's/arm64/aarch64/') tools/buildenv
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import platform
import shutil
import subprocess
import sys
import tarfile
import time
import tomllib
import urllib.request
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
PACKAGES_DIR = ROOT / "packages"
OUTPUT_DIR = ROOT / "output"
CACHE_DIR = ROOT / "cache"
BUILD_DIR = ROOT / "build"
HOST_PROVIDES_FILE = ROOT / "host" / "provides.txt"
BUILDENV_IMAGE = "yojigen/buildenv"

ARCH_ALIASES = {
    "arm64": "aarch64",
    "aarch64": "aarch64",
    "x86_64": "x86_64",
    "amd64": "x86_64",
}


# --------------------------------------------------------------- 基础工具

def log(stage: str, msg: str) -> None:
    print(f"\033[1m[{stage}]\033[0m {msg}", flush=True)


def die(msg: str) -> None:
    sys.stdout.flush()      # 否则 stdout 里的进度会冒到错误信息后面
    print(f"\033[31mskirt: 错误\033[0m {msg}", file=sys.stderr)
    sys.exit(1)


def sha256_of(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def rmtree_force(path: Path) -> None:
    """删除目录树，带重试。

    在 macOS + Docker 绑定挂载下，容器刚退出时文件系统状态可能尚未同步完，
    shutil.rmtree 内部的 os.rmdir 会偶发 "Directory not empty"——即使目录
    实际上已经被掏空了。重试可以跨过这个窗口。
    """
    if not path.exists():
        return
    last: OSError | None = None
    for attempt in range(5):
        try:
            shutil.rmtree(path)
            return
        except OSError as exc:
            last = exc
            time.sleep(0.5 * (attempt + 1))
    die(f"清理失败: {path}\n       {last}\n"
        f"       这通常只是文件系统同步慢，手动删除该目录后重试即可。")


def resolve_arch(requested: str | None) -> str:
    host = ARCH_ALIASES.get(platform.machine())
    if host is None:
        die(f"不认识的宿主架构: {platform.machine()}")
    if requested is None:
        return host
    want = ARCH_ALIASES.get(requested, requested)
    if want != host:
        die(
            f"暂不支持交叉构建：宿主是 {host}，请求的是 {want}。\n"
            f"       交叉工具链要等工具链自举之后才会加上，见 docs/ 里的架构策略。"
        )
    return want


# ------------------------------------------------------------------ 配方

def load_spec(name: str) -> dict:
    path = PACKAGES_DIR / name / "spec.toml"
    if not path.is_file():
        die(f"找不到配方: {path}")
    with path.open("rb") as f:
        spec = tomllib.load(f)
    if "package" not in spec:
        die(f"{path}: 缺少 [package] 段")
    for key in ("name", "version"):
        if key not in spec["package"]:
            die(f"{path}: [package] 缺少 {key}")
    spec["_dir"] = path.parent
    return spec


def expand(spec: dict, value):
    """展开 $NAME / $VERSION 占位符。"""
    pkg = spec["package"]
    if isinstance(value, str):
        return (value
                .replace("$NAME", pkg["name"])
                .replace("$VERSION", pkg["version"]))
    if isinstance(value, list):
        return [expand(spec, v) for v in value]
    if isinstance(value, dict):
        return {k: expand(spec, v) for k, v in value.items()}
    return value


def deps_for(spec: dict, arch: str) -> dict:
    """合并通用依赖与架构特定依赖（架构特定值整体覆盖同名键）。"""
    deps = dict(spec.get("dependencies", {}))
    per_arch = deps.pop(arch, None)
    if isinstance(per_arch, dict):
        deps.update(per_arch)
    return deps


def direct_deps(spec: dict, arch: str) -> list[str]:
    """直接依赖 = runtime + build，去重且保持声明顺序。"""
    d = deps_for(spec, arch)
    out: list[str] = []
    for key in ("runtime", "build"):
        for name in d.get(key, []):
            if name not in out:
                out.append(name)
    return out


# ---------------------------------------------------------------- 依赖解析

def load_host_provides() -> set[str]:
    """读取 host/provides.txt —— 宿主已经提供的包。"""
    if not HOST_PROVIDES_FILE.is_file():
        return set()
    out = set()
    for line in HOST_PROVIDES_FILE.read_text(encoding="utf-8").splitlines():
        line = line.split("#", 1)[0].strip()
        if line:
            out.add(line)
    return out


def dep_closure(spec: dict, arch: str, host_provides: set[str]) -> list[str]:
    """返回按安装顺序排列的依赖包名（依赖在前，不含自身，已剔除宿主提供的）。

    自依赖不算成环，它是自举的常态：构建 make 需要 make，构建 gcc 需要 gcc
    （gcc 的 stage1 → stage2 正是这个模式）。此时用「上一轮构建出的自己」；
    若还没构建过，说明是第一次，交由当前构建环境提供即可。
    """
    order: list[str] = []
    done: set[str] = set()
    stack: list[str] = []
    self_name = spec["package"]["name"]

    def visit(name: str) -> None:
        if name in host_provides or name in done:
            return
        if name in stack:
            die(f"依赖成环: {' → '.join(stack + [name])}")
        child_spec = load_spec(name)
        stack.append(name)
        for child in direct_deps(child_spec, arch):
            if child == name:
                continue        # 自己依赖自己 = 用上一轮构建产物，不是环
            visit(child)
        stack.pop()
        done.add(name)
        order.append(name)

    for name in direct_deps(spec, arch):
        if name == self_name:
            if built_payload(name, arch) is not None:
                order.append(name)      # 有上一轮的自己，就用它
            else:
                log("解析", f"{name}: 首次构建，使用构建环境自带的版本")
            continue
        visit(name)
    return order


def built_payload(name: str, arch: str) -> Path | None:
    """若该包已构建过则返回其 payload，否则返回 None（不报错）。"""
    if not (PACKAGES_DIR / name / "spec.toml").is_file():
        return None
    pkg = load_spec(name)["package"]
    payload = OUTPUT_DIR / arch / f"{pkg['name']}-{pkg['version']}-{pkg['release']}" / "payload"
    return payload if payload.is_dir() else None


def dep_payload(name: str, arch: str) -> tuple[Path, str]:
    """找到依赖包已构建的 payload。"""
    pkg = load_spec(name)["package"]
    rel = f"{pkg['name']}-{pkg['version']}-{pkg['release']}"
    payload = OUTPUT_DIR / arch / rel / "payload"
    if not payload.is_dir():
        die(
            f"依赖 {name} 还没有构建（找不到 {payload.relative_to(ROOT)}/）\n"
            f"       先执行:  tools/skirt build {name}"
        )
    return payload, rel


def build_sysroot(order: list[str], arch: str) -> Path:
    """把依赖按顺序叠加成 sysroot。后面的包会覆盖前面同路径的文件。"""
    sysroot = BUILD_DIR / "sysroot"
    sysroot.mkdir(parents=True, exist_ok=True)
    for name in order:
        payload, rel = dep_payload(name, arch)
        shutil.copytree(payload, sysroot, symlinks=True, dirs_exist_ok=True)
        n = sum(1 for _ in payload.rglob("*"))
        log("依赖", f"{rel}  ({n} 项)")
    return sysroot


# -------------------------------------------------------------- 下载校验

def fetch(spec: dict) -> Path:
    pkg = spec["package"]
    sources = spec.get("source") or []
    if not sources:
        die(f"{pkg['name']}: 配方没有声明 source")

    src = sources[0]
    url = expand(spec, src["url"])
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    dest = CACHE_DIR / url.rsplit("/", 1)[-1]

    if dest.is_file():
        log("下载", f"缓存命中 {dest.name}")
    else:
        log("下载", url)
        tmp = dest.with_name(dest.name + ".part")
        urllib.request.urlretrieve(url, tmp)
        tmp.rename(dest)

    want = str(src.get("sha256", "")).strip().lower()
    if len(want) != 64:
        die(f"{pkg['name']}: 源码没有声明有效的 sha256"
            f"（不接受未校验的源码，当前值: {want!r}）")

    got = sha256_of(dest)
    if got != want:
        die(f"{pkg['name']}: sha256 不匹配\n"
            f"       期望 {want}\n"
            f"       实际 {got}\n"
            f"       文件 {dest}")
    log("校验", "sha256 匹配")
    return dest


def extract(archive: Path, into: Path) -> str:
    """解压到 into，返回源码根目录相对名（'.' 表示就是 into 本身）。"""
    rmtree_force(into)
    into.mkdir(parents=True)
    log("解压", archive.name)
    with tarfile.open(archive) as tf:
        try:
            tf.extractall(into, filter="data")
        except TypeError:      # Python < 3.12
            tf.extractall(into)
    entries = list(into.iterdir())
    if len(entries) == 1 and entries[0].is_dir():
        return entries[0].name
    return "."


# ------------------------------------------------------------ 生成构建脚本

def make_build_script(spec: dict) -> str:
    """把 [build] 表翻译成 shell。steps.sh 可通过重定义函数覆盖。"""
    b = spec.get("build", {})
    kind = b.get("type", "custom")
    oot = bool(b.get("out_of_tree", False))

    if oot and kind != "autotools":
        die(f"{spec['package']['name']}: out_of_tree 目前只支持 autotools"
            f"（meson 和 cmake 本来就是离开源码树构建的）")

    header = "export PKGDEST=/work/dest\n"
    if oot:
        header += 'BUILDDIR="$SRCDIR/_build"\n'

    if kind == "autotools":
        opts = " ".join(b.get("configure", ["--prefix=/usr"]))
        if oot:
            body = ('  mkdir -p "$BUILDDIR"\n'
                    '  cd "$BUILDDIR"\n'
                    f'  "$SRCDIR/configure" {opts}\n'
                    '  make')
            pkgstep = ('  cd "$BUILDDIR"\n'
                       '  make DESTDIR="$PKGDEST" install')
        else:
            body = f"  ./configure {opts}\n  make"
            pkgstep = '  make DESTDIR="$PKGDEST" install'
    elif kind == "meson":
        opts = " ".join(b.get("configure", ["--prefix=/usr", "--buildtype=release"]))
        body = f"  meson setup _build {opts}\n  meson compile -C _build"
        pkgstep = '  DESTDIR="$PKGDEST" meson install -C _build'
    elif kind == "cmake":
        opts = " ".join(b.get("configure", ["-DCMAKE_INSTALL_PREFIX=/usr"]))
        body = f"  cmake -B _build {opts}\n  cmake --build _build"
        pkgstep = '  DESTDIR="$PKGDEST" cmake --install _build'
    elif kind == "custom":
        body = "  : # 由 steps.sh 提供"
        pkgstep = "  : # 由 steps.sh 提供"
    else:
        die(f"{spec['package']['name']}: 不认识的构建类型 {kind!r}")

    return (
        header
        + "\n"
        "build() {\n" + body + "\n}\n"
        "\n"
        "package() {\n" + pkgstep + "\n}\n"
        "\n"
        "# steps.sh 若存在，可以通过重定义上面任意函数来覆盖默认行为\n"
        "if [ -f /work/steps.sh ]; then . /work/steps.sh; fi\n"
        "\n"
        "build\n"
        "package\n"
    )


def run_in_container(script: str, srcrel: str, arch: str, spec: dict) -> None:
    pkg = spec["package"]
    workdir = "/work/src" if srcrel == "." else f"/work/src/{srcrel}"
    (BUILD_DIR / "home").mkdir(parents=True, exist_ok=True)
    sysroot = BUILD_DIR / "sysroot"
    sysroot.mkdir(parents=True, exist_ok=True)

    wrapper = (
        "set -euo pipefail\n"
        "\n"
        "# 结束时把 /work 的属主还给宿主用户，否则宿主无法清理\n"
        'cleanup() { chown -R "$HOSTUID:$HOSTGID" /work 2>/dev/null || true; }\n'
        "trap cleanup EXIT\n"
        "\n"
        "# 把依赖包的 payload 合并进根文件系统\n"
        'if [ -d /mnt/sysroot ] && [ -n "$(ls -A /mnt/sysroot 2>/dev/null)" ]; then\n'
        '  echo "[依赖] 合并 $(find /mnt/sysroot \\( -type f -o -type l \\) | wc -l | tr -d " ") 项到 /"\n'
        "  cp -a /mnt/sysroot/. /\n"
        "fi\n"
        "\n"
        + script
    )

    # 需要 root：要把依赖合并进 /usr。容器加 --rm，不会污染宿主。
    # MAKEFLAGS 通过环境变量传给所有 make（含子 make），省得每个配方各写一遍 -j。
    jobs = str(os.cpu_count() or 4)
    cmd = [
        "docker", "run", "--rm",
        "-e", f"HOSTUID={os.getuid()}",
        "-e", f"HOSTGID={os.getgid()}",
        "-e", "HOME=/work/home",
        "-e", f"PKGARCH={arch}",
        "-e", f"PKGNAME={pkg['name']}",
        "-e", f"PKGVER={pkg['version']}",
        "-e", f"SRCDIR={workdir}",
        "-e", f"MAKEFLAGS=-j{jobs}",
        "-v", f"{BUILD_DIR}:/work",
        "-v", f"{sysroot}:/mnt/sysroot:ro",
        "-w", workdir,
        f"{BUILDENV_IMAGE}:{arch}",
        "bash", "-c", wrapper,
    ]

    log("构建", f"{BUILDENV_IMAGE}:{arch}  (cwd={workdir}, -j{jobs})")
    proc = subprocess.run(cmd)
    if proc.returncode != 0:
        die(f"构建失败（退出码 {proc.returncode}）")


# ------------------------------------------------------------------ 收集

def collect(spec: dict, arch: str) -> tuple[Path, int]:
    pkg = spec["package"]
    destdir = BUILD_DIR / "dest"
    out = OUTPUT_DIR / arch / f"{pkg['name']}-{pkg['version']}-{pkg['release']}"

    rmtree_force(out)
    payload = out / "payload"
    payload.parent.mkdir(parents=True, exist_ok=True)
    shutil.copytree(destdir, payload, symlinks=True)

    files = []
    for p in sorted(payload.rglob("*")):
        rel = str(p.relative_to(payload))
        if p.is_symlink():
            files.append({"path": rel, "type": "symlink", "target": os.readlink(p)})
        elif p.is_file():
            files.append({
                "path": rel,
                "type": "file",
                "size": p.stat().st_size,
                "sha256": sha256_of(p),
            })
        elif p.is_dir():
            files.append({"path": rel + "/", "type": "dir"})

    deps = deps_for(spec, arch)
    meta = {
        "name": pkg["name"],
        "version": pkg["version"],
        "release": pkg["release"],
        "arch": arch,
        "description": pkg.get("description", ""),
        "section": pkg.get("section", ""),
        "license": pkg.get("license", ""),
        "url": pkg.get("url", ""),
        "depends": deps.get("runtime", []),
        "build_depends": deps.get("build", []),
        "built_at": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
        "files": files,
    }
    (out / "meta.json").write_text(
        json.dumps(meta, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    return out, len(files)


# ------------------------------------------------------------------ 命令

def cmd_build(args) -> None:
    arch = resolve_arch(args.arch)
    spec = load_spec(args.package)
    pkg = spec["package"]
    name, ver, rel = pkg["name"], pkg["version"], pkg["release"]

    steps = spec["_dir"] / "steps.sh"
    kind = spec.get("build", {}).get("type", "custom")
    if kind == "custom" and not steps.is_file():
        die(f"{name}: type = \"custom\" 但没有 steps.sh，没有任何构建步骤")

    print()
    log("开始", f"{name} {ver}-{rel} [{arch}]")

    rmtree_force(BUILD_DIR)
    (BUILD_DIR / "dest").mkdir(parents=True)

    # 依赖
    host_provides = load_host_provides()
    order = dep_closure(spec, arch, host_provides)
    if order:
        log("解析", f"依赖链: {' → '.join(order + [name])}")
    else:
        log("解析", "无自建依赖（全部由宿主提供）")
    build_sysroot(order, arch)

    # 源码
    print()
    archive = fetch(spec)
    srcrel = extract(archive, BUILD_DIR / "src")

    if steps.is_file():
        shutil.copy2(steps, BUILD_DIR / "steps.sh")
        log("步骤", "已加载 steps.sh")

    print()
    run_in_container(make_build_script(spec), srcrel, arch, spec)

    out, count = collect(spec, arch)
    print()
    log("完成", f"{out.relative_to(ROOT)}/  （{count} 项）")


def cmd_deps(args) -> None:
    """只解析依赖，不构建 —— 用来调试配方。"""
    arch = resolve_arch(args.arch)
    spec = load_spec(args.package)
    name = spec["package"]["name"]
    host_provides = load_host_provides()

    print(f"\n{name} [{arch}]")
    print(f"  直接依赖 : {direct_deps(spec, arch) or '（无）'}")
    print(f"  宿主提供 : {sorted(host_provides) or '（无）'}")
    order = dep_closure(spec, arch, host_provides)
    print(f"  需自建   : {order or '（无）'}")
    print(f"  构建顺序 : {' → '.join(order + [name])}\n")
    if order:
        for dep in order:
            payload, rel = dep_payload(dep, arch)
            print(f"    ✅ {rel:<28} {payload.relative_to(ROOT)}")
        print()


def cmd_list(args) -> None:
    if not PACKAGES_DIR.is_dir():
        print("(还没有 packages/ 目录)")
        return
    names = sorted(
        p.name for p in PACKAGES_DIR.iterdir()
        if p.is_dir() and (p / "spec.toml").is_file()
    )
    if not names:
        print("(还没有任何包)")
        return
    for n in names:
        pkg = load_spec(n)["package"]
        print(f"  {pkg['name']:<16} {pkg['version']}-{pkg['release']:<5} "
              f"{pkg.get('description', '')}")


def cmd_clean(args) -> None:
    if BUILD_DIR.exists():
        rmtree_force(BUILD_DIR)
        log("清理", "build/")
    if args.package and OUTPUT_DIR.is_dir():
        for arch_dir in sorted(OUTPUT_DIR.iterdir()):
            if not arch_dir.is_dir():
                continue
            for d in sorted(arch_dir.glob(f"{args.package}-*")):
                rmtree_force(d)
                log("清理", f"{d.relative_to(ROOT)}/")
    if not args.package:
        log("提示", "未指定包名，只清理了 build/（产物保留）")


def main() -> None:
    ap = argparse.ArgumentParser(
        prog="skirt",
        description="YojigenOS 构建驱动 —— 短裙里装着四次元空间",
    )
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("build", help="构建一个包")
    p.add_argument("package")
    p.add_argument("--arch", help="目标架构（默认当前架构）")
    p.set_defaults(func=cmd_build)

    p = sub.add_parser("deps", help="查看依赖解析结果（不构建）")
    p.add_argument("package")
    p.add_argument("--arch", help="目标架构（默认当前架构）")
    p.set_defaults(func=cmd_deps)

    p = sub.add_parser("list", help="列出所有包")
    p.set_defaults(func=cmd_list)

    p = sub.add_parser("clean", help="清理构建目录 / 指定包的产物")
    p.add_argument("package", nargs="?")
    p.set_defaults(func=cmd_clean)

    args = ap.parse_args()
    args.func(args)


if __name__ == "__main__":
    try:
        main()
    except BrokenPipeError:
        # 输出被下游截断（例如 `skirt build x | head`）。这时构建本身往往
        # 还在正常进行，不该报一个看不懂的 traceback。把 stdout 换成
        # /dev/null 让后续写入无处可去，然后安静退出。
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        sys.exit(0)
