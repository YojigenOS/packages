
# 本机工具环境（可由工具重新安装，等价于 node_modules）
/.dsh/

# 构建产物与源码缓存。全在 var/ 下——这样 ls 一眼分得清源码和产物。
/var/
*.apk
*.deb
*.rpm

# Python
__pycache__/
*.py[cod]

# 编辑器与系统
.DS_Store
*.swp
.idea/
.vscode/
# >>> Comet managed project state >>>
!/.comet/
/.comet/*
!/.comet/config.yaml
# <<< Comet managed project state <<<

# CI 把 distro 仓库取到这儿（bootstrap.yml 的"取 distro"那一步）
.distro/
