#!/bin/sh
# filesystem 的 post-install —— 把新的系统组补进 /etc/group。
#
# ══ 一个必须说清的约束（2026-10-23 撞到的）════════════════════════════════
#
# **`filesystem` 是最底层的包。它 install 的时候，系统上可能只有 `/bin/sh`。**
#
# 我第一版用了 `getent` / `groupmod` / `find` / `cut` / `sort` —— 而 apk 报：
#
#     ERROR: lib/apk/exec/filesystem-1.0-r12.post-install: exited with error 127
#
# 127 = 命令找不到。而 `filesystem` 的 `runtime = []`：给它加 shadow 之类会造成
# **循环依赖**（shadow 依赖 filesystem）。所以这个脚本**不能假设那些工具在**。
#
# ★ Debian 怎么解决同一件事：`base-passwd` 带一个 **C 程序** `update-passwd`，
#   它直接读写 /etc/group —— 不调任何外部命令。那是正解，但要新包。
#
# ★★ 所以这里做的是**最小的一件事**：只补「权威表里有、系统上没有」的组。
#     - `while read` / `case` / `[` 都是 shell 内建，一定有
#     - 不改已有组的 GID（那需要 groupmod，而且改完还要 chgrp 一堆文件）
#
#   而"改已有组的 GID"交给 `sysusers`（它本来就是干这个的，而且是 C 程序）——
#   见 init/systemd 配方里 `-Dutmp-gid=43` 那一串：**GID 是构建时钉死的**，
#   所以 sysusers 建的组一开始就是对的，不需要事后改。

set -e

# 权威表：优先 .apk-new（apk 因"文件被改过"留下的新版本），否则包自带的那份
NEW=/etc/group.apk-new
[ -f "$NEW" ] || NEW=/usr/share/yojigen-os/group.master
[ -f "$NEW" ] || exit 0

# ── 只补缺的：纯 shell，逐行读 ────────────────────────────────────────────
#
# ★ 判据是"这个名字在 /etc/group 里出现过没有" —— 用 `case` 和一个拼起来的
#   字符串做，避免 grep（不保证有）。
现有=" "
while IFS=: read -r name _rest; do
    case "$name" in
        ''|'#'*) continue ;;
    esac
    现有="$现有$name "
done < /etc/group

补了=0
while IFS=: read -r name _pw gid members; do
    case "$name" in
        ''|'#'*) continue ;;
    esac
    case "$现有" in
        *" $name "*) continue ;;   # 已经有了 —— 不动它（那可能是管理员改过的）
    esac
    # 没有 → 补进去（保留权威表里的 GID 和成员）
    printf '%s:x:%s:%s\n' "$name" "$gid" "$members" >> /etc/group
    现有="$现有$name "
    补了=$((补了 + 1))
done < "$NEW"

[ "$补了" -gt 0 ] && echo "  [filesystem] 补了 $补了 个系统组进 /etc/group"

# 只删我们读的那份临时文件；master 留着（下次升级还要用）
[ "$NEW" = /etc/group.apk-new ] && rm -f "$NEW"
exit 0
