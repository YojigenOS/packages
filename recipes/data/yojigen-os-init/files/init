#!/bin/sh
# Yojigen OS 的 init
#
# 这是内核把控制权交给用户空间之后跑的【第一个】程序。保持它小：
# 挂上伪文件系统、说一句话、跑一遍首启钩子、起一个 shell。
#
# 【首启钩子是什么，为什么在这里】
#
# /usr/lib/yojigen-os/boot.d/ 下的脚本，按名字顺序跑。这是个【面向包的约定】：
# openssh 要生成主机密钥并起 sshd，将来的东西（machine-id、locale、growpart…）
# 也都要在启动时做点什么，而 /init 不该知道它们每一个是谁。
#
# 这不是"服务管理"——没有依赖排序、没有重启策略、没有日志。等真有第二个
# 需求再谈那些（0007：没有真实需求之前不写代码）。
#
# 【为什么先往串口打印】开机失败时看不到屏幕，只能看串口。所以第一件事
# 就是打个招呼——如果连这行都看不到，问题在内核而不是在这里。

# 没有 PATH 的话连 mount 都找不到。
export PATH=/usr/bin:/usr/sbin:/bin:/sbin
export HOME=/root

# --- 伪文件系统 ---------------------------------------------------------
# devtmpfs 由内核自动挂载（CONFIG_DEVTMPFS_MOUNT），这里补挂其余的。
mount -t proc     proc     /proc    2>/dev/null
mount -t sysfs    sysfs    /sys     2>/dev/null
# ★ /dev/pts 这个【目录】要先有 —— devtmpfs 不会替我们建它。
#
#   少了 mkdir，mount 会因为"目标不存在"失败，而 `2>/dev/null` 把这句话
#   藏了起来。后果不是"少挂一个文件系统"，是**SSH 上来拿不到终端**：
#
#       PTY allocation request failed on channel 0
#
#   实测在真机上撞到。★ 教训：**那句 2>/dev/null 把一个真实的失败静音了** ——
#   而它是启动路径上最重要的一类失败。
mkdir -p /dev/pts
if ! mount -t devpts devpts /dev/pts 2>/dev/null; then
    echo "  ⚠ /dev/pts 挂不上——SSH 会拿不到终端"
fi
mount -t tmpfs    tmpfs    /tmp     2>/dev/null
mount -t tmpfs    tmpfs    /run     2>/dev/null

# --- "这台机器已经起来了"这个事实 ---------------------------------------
#
# 决策记录 0024 里那条判据要用它：一个包的 `post-install` 想知道自己是在
# 【一台正在跑的系统】上被装的（那就该顺手把服务启用并起起来），还是在
# 【离线组装镜像】时被装进去的（那就不该动启用状态，交给风味声明）。
#
# ★ 判据必须是一个【事实】而不是一个开关：没有谁会去设它，它是启动过程留下的
#   痕迹。/run 是 tmpfs，所以它天然"这次开机才有"，重启就没了 —— 正合适。
mkdir -p /run/yojigen-os 2>/dev/null
: > /run/yojigen-os/booted 2>/dev/null

# ★★ /dev/fd 那一组符号链接 —— devtmpfs【不会】建它们。
#
#   devtmpfs（内核自动挂的那一个）只给【设备节点】。而 `/dev/fd`、`/dev/stdin`
#   这些是【指向 /proc/self/fd 的符号链接】—— 得有人来建。
#
#   别人的系统谁建：
#       Alpine  → busybox 的 mdev
#       Debian  → systemd-tmpfiles
#       我们    → 没人 ✗（没有 busybox，也没有 systemd）
#
#   ★ 而少了它们的后果是实打实的：**bash 的进程替换（`> >(…)` / `<(…)`）
#     整个不能用** —— 它底层要打开 `/dev/fd/N`。
#
#   实测（2026-10-15 晚，真机 TX 上跑 reinstall.sh）：
#
#       /root/ri.sh: line 412: /dev/fd/63: No such file or directory
#
#   —— 而那一句是 `1> >(exec head -c 1048576 >$tmp_file)`。**一个纯诊断的句子
#   因为它挂了，一晚上咬了两次**（第二次是重启之后，因为 /dev 是 devtmpfs，
#   手工建的会没）。
#
#   ★ 所以必须在【这里】建：每次开机都建，而不是靠别人记得。
mkdir -p /dev
ln -sfn /proc/self/fd   /dev/fd
ln -sfn /proc/self/fd/0 /dev/stdin
ln -sfn /proc/self/fd/1 /dev/stdout
ln -sfn /proc/self/fd/2 /dev/stderr

# ★ 而这几行【要说自己成没成】——和上面 /dev/pts 那段同一个道理。
#
#   建这几个链接是"安静的"：成不成都不影响后面几步，所以要等【很久以后】
#   某个脚本用进程替换时报错才发现。而那时人早就不在场了。
#   而它在 build/CI 那条路上【永远不会报】——因为那里没人跑 bash 进程替换。
#
#   所以这里自检一遍，失败就说出来：
for _l in fd stdin stdout stderr; do
    if [ ! -L "/dev/$_l" ]; then
        echo "  ⚠ /dev/$_l 没建出来——用进程替换的脚本（bash 的 <(…) 和 >(…)）会报"
        echo "     /dev/fd/N: No such file or directory"
    fi
done
unset _l

# 而正面那条也要说：这几个链接【能不能真读】取决于 /proc 挂没挂上。
# （/proc 是上面挂的；这里只查一次，成了就一行，不吵。）
if [ -r /proc/self/fd/0 ]; then
    echo "  /dev/fd 那组符号链接就位（进程替换可用）"
else
    echo "  ⚠ /proc 没挂上——/dev/fd 指向的 /proc/self/fd 读不到"
fi

# --- 问候 ---------------------------------------------------------------
echo
echo "  欢迎来到 Yojigen OS"
echo

# 把「这台机器到底是什么」摊开说——出问题时这几行就是线索。
if [ -r /etc/os-release ]; then
    . /etc/os-release
    echo "    ${PRETTY_NAME:-Yojigen OS}"
fi
echo "    内核      $(uname -r)"
echo "    架构      $(uname -m)"
echo "    日期      $(date -u '+%Y-%m-%d %H:%M UTC')"
echo
echo "    这是从源码一步步建出来的系统，不是任何发行版的魔改。"
echo

# --- 首启钩子 -----------------------------------------------------------
# 包往这里放脚本。按名字排序 = 顺序可控（靠前缀数字），不依赖文件系统返回的
# 顺序。任何一个钩子失败都不拦启动：它起不来，人还能从串口进去查；
# 而如果这里 exit，系统就停在一个连 shell 都没有的地方。
if [ -d /usr/lib/yojigen-os/boot.d ]; then
    for f in /usr/lib/yojigen-os/boot.d/*; do
        [ -x "$f" ] || continue
        echo "  ▸ $(basename "$f")"
        "$f" || echo "    ⚠ 这个钩子失败了，继续"
    done
    echo
fi

# --- 启用的服务 ---------------------------------------------------------
#
# 决策记录 0024：**服务由【风味】启用，包只提供定义。**
#
# 这里和上面 boot.d 的分界是这一句：
#
#   boot.d      【没有它这台机器不算能用】—— 挂 cgroup、设 hostname、扩根分区
#   服务        它没起来，系统照样是系统 —— sshd、dockerd、将来的各种守护进程
#
# 启用状态就是 /etc/services/ 里的软链（由 `service enable` 或风味组装时建的），
# 而定义在 /usr/lib/yojigen-os/services/。这里只负责"按启用的那些，逐个 start"。
#
# ★ 和 boot.d 一样：**任何一个失败都不拦启动**。一个服务起不来，人还能从串口
#   进去查；而如果这里 exit，系统就停在一个连 shell 都没有的地方。
#
# ★★ 而"起了哪些、结果如何"要留痕：/run/yojigen-os/services.log。
#   不然"开机后 ssh 连不上"只能靠猜 —— 那正是 0024 想避免的那类排查。
if [ -d /etc/services ] && [ -n "$(ls -A /etc/services 2>/dev/null)" ]; then
    echo "  启用的服务："
    mkdir -p /run/yojigen-os 2>/dev/null
    for s in /etc/services/*; do
        [ -e "$s" ] || continue
        name=$(basename "$s")
        echo "  ▸ $name"
        if "$s" start; then
            echo "$name ok" >> /run/yojigen-os/services.log
        else
            echo "    ⚠ $name 没起来，继续"
            echo "$name failed" >> /run/yojigen-os/services.log
        fi
    done
    echo
fi

# --- SysV 的 rc 软链（兼容层）-------------------------------------------
#
# 生态里"开机自启"有两种写法，而我们要两种都能认：
#
#   /etc/services/<名字>      我们自己的（决策记录 0024，包提供定义 + 风味启用）
#   /etc/rc2.d/S<N><名字>     SysV 的（老安装脚本和管理员习惯的写法）
#
# ★ 为什么必须支持后一种：**很多既有的安装脚本只认它**。实测 1Panel 的
#   install.sh 在没有 systemctl 时就把自己的 `.init` 脚本放进 /etc/init.d/
#   再建 rc 软链 —— 没有那个目录它直接报 No such file or directory。
#
# ★★ 只跑大写 `S` 开头的（S = start）；`K` 开头的是关机时停的，这里不管。
#    而运行级只跑 2：我们是单运行级的系统，2/3/4/5 都跑会让同一个服务起两遍。
#
# 和上面一样：**失败不拦启动**。
if [ -d /etc/rc2.d ] && [ -n "$(ls -A /etc/rc2.d 2>/dev/null)" ]; then
    echo "  SysV 启用的服务："
    for s in /etc/rc2.d/S*; do
        [ -e "$s" ] || continue
        [ -x "$s" ] || continue
        name=$(basename "$s" | sed 's/^S[0-9]*//')
        if [ -e "/etc/services/$name" ]; then
            continue          # 已经在上面按我们的方式起过了
        fi
        echo "  ▸ $name"
        if "$s" start; then
            echo "$name ok (sysv)" >> /run/yojigen-os/services.log
        else
            echo "    ⚠ $name 没起来，继续"
            echo "$name failed (sysv)" >> /run/yojigen-os/services.log
        fi
    done
    echo
fi

# --- 起 shell -----------------------------------------------------------
# 开机就进 root shell。现在还没有用户体系（没有 shadow/pam），
# 那些属于「能装软件」那一层，不在「能开机」里。
echo "  进入 shell。输入 exit 关机。"
echo

# ── VGA 上也开一个 shell ────────────────────────────────────────────────────
#
# ★ 为什么需要：cmdline 是 `console=tty0 console=ttyS0,115200`，而
#   **写在最后的那个会成为 /dev/console**。所以下面那个 exec 落在【串口】上，
#   tty0（VGA）只有内核日志、没有 getty、没有提示符。
#
#   本地看不出来（QEMU 用 -serial file: 抓的是串口日志，一切正常）。
#   而一台上云主机上——**VNC 连的是 tty0**，于是"在控制台里敲什么都没反应"。
#
#   实测撞上：腾讯云 VNC 里一直只有内核日志，按键变成
#   `atkbd serio0: Unknown key pressed`——那是 PS/2 键盘事件，
#   说明 VNC 连的是 tty0，而我们的 shell 不在那儿。
#
#   cttyhack + tty0：在 VNC 那个终端上开一个 shell。
#
#   ★ 为什么不是裸 setsid。
#
#   setsid 建的是一个【新会话】，而新会话没有控制终端。于是那个 shell 一开口
#   就是：
#
#       /bin/sh: 0: can't access tty; job control turned off
#
#   而那是开机第一眼看到的东西——看着像"系统坏了"。
#
#   之后把标准输入输出接到 /dev/tty0 也【不管用】：Linux 的规矩是只有会话首
#   进程【主动】调 ioctl(TIOCSCTTY) 才算数，而 shell 不做这件事（那是
#   login/getty 的活儿）。所以有了 cttyhack —— 一个二十行的小程序，
#   详见 files/cttyhack.c。
#
#   ★ 这里【不】套 while、也【不】关机：这只是 VNC 上一个额外的 shell，
#     它退出了就该安安静静地结束。关机是 PID1 那边的事（见文件末尾）。
if [ -x /usr/libexec/cttyhack ] && [ -c /dev/tty0 ]; then
    /usr/libexec/cttyhack /dev/tty0 sh &
fi

# ── PID1 ────────────────────────────────────────────────────────────────────
#
# ★ PID1 不能【退出】—— 退出了内核会 panic（"Attempted to kill init"）。
#
#   所以包一层：shell 退出来就把机器【干净地】关掉。
#   "开机进 shell"是这个阶段的全部内容（0007：没有真实需求之前不写代码），
#   所以这里不引入服务管理，只把"退出"变成一个可预期的结果。
while :; do
    /bin/sh
    echo
    echo "  shell 退出了。PID1 不能退出（内核会 panic），所以现在关机。"
    # ★ 而这条 fallback 是【真的会走到】的 —— 2026-10-15 才发现。
    #
    #   `poweroff` 此前【不在这个系统里】：util-linux 早就不提供它了
    #   （2.42 的源码里 reboot/poweroff/shutdown/halt 一个都没有），
    #   别人的系统靠 busybox 或 systemd，而我们两个都没有。
    #   所以这句一直是"找不到命令"，只是没人走到这条路上。
    #
    #   现在 `yojigen-os-init` 自己提供 `poweroff` / `reboot`（见该配方的
    #   files/），而 sysrq 那条路是最后的兜底 —— 它不依赖任何用户态程序。
    if poweroff -f 2>/dev/null || poweroff 2>/dev/null; then
        break
    fi
    if [ "$(cat /proc/sys/kernel/sysrq 2>/dev/null)" != "0" ]; then
        echo "  poweroff 不可用，走 sysrq。"
        sync
        echo o > /proc/sysrq-trigger
        sleep 5
    fi
    echo "  ⚠ 关机命令不可用。停在 PID1 循环里（别 Ctrl-D）。"
    sleep 3600
done
