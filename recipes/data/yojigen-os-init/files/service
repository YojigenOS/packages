#!/bin/sh
# service —— 启用 / 停用 / 起停一个服务。
#
# 决策记录 0024：**服务由风味启用，包只提供定义。**
#
#   /usr/lib/yojigen-os/services/<名字>   定义（包提供，只有 start / stop）
#   /etc/services/<名字>                  启用的软链（属于管理员，走 conffiles）
#
# 而 /init 在跑完 boot.d 之后，逐个 start 这个目录里启用的那些。
#
# ★ 为什么"启用"是一条软链而不是一份配置里的名字列表：
#   软链在盘上看得见（`ls /etc/services/`），而删掉它就是停用 —— 不需要一个
#   解析器，也不会出现"配置里写了但那个文件不在"的悬空状态。
#
# ★★ 而这份脚本里【标识符全是 ASCII】：变量名和函数名在 POSIX sh 里只允许
#    [A-Za-z_][A-Za-z0-9_]*。中文注释随便写，中文【标识符】会被 dash 拒（函数名）
#    或者静默变成空（变量名）—— 后者更糟，因为它不报错。

SETS=/etc/services
DEFS=/usr/lib/yojigen-os/services

usage() {
  cat <<EOF
用法: service <动作> [名字]

  list              列出所有定义，以及启用/停用
  enable <名字>     开机自启
  disable <名字>    取消自启
  start <名字>      现在起一个（不改变自启状态）
  stop <名字>       现在停一个
  status <名字>     它这次开机起过没有

定义在 ${DEFS}，启用状态在 ${SETS}。
EOF
}

list_all() {
  if [ ! -d "$DEFS" ] || [ -z "$(ls -A "$DEFS" 2>/dev/null)" ]; then
    echo "  （这个系统里一个服务定义都没有）"
    return 0
  fi
  n_on=0
  n_off=0
  for d in "$DEFS"/*; do
    [ -e "$d" ] || continue
    n=$(basename "$d")
    if [ -e "$SETS/$n" ]; then
      echo "  ✓ $n    （已启用）"
      n_on=$((n_on + 1))
    else
      echo "  · $n    （未启用）"
      n_off=$((n_off + 1))
    fi
  done
  echo
  echo "  已启用 $n_on 个，未启用 $n_off 个。"
  if [ -d /etc/init.d ] && [ -n "$(ls -A /etc/init.d 2>/dev/null)" ]; then
    echo
    echo "  还有这些 SysV 的（/etc/init.d）："
    for d in /etc/init.d/*; do
      [ -e "$d" ] || continue
      echo "  · $(basename "$d")"
    done
  fi
}

# ★★ 两套服务定义，`service` 两套都认（2026-10-22）。
#
#   我们自己那套     /usr/lib/yojigen-os/services/<名字>   起停由定义自己实现
#   SysV 那套        /etc/init.d/<名字>                    转给它，动作原样传
#
# ★ 为什么必须认第二套：**很多既有的东西就是用 `service <名字> <动作>` 探测
#   服务的**。实测 1Panel 的安装脚本判"服务起没起"就是
#
#       service 1panel-core status >/dev/null 2>&1 && echo active
#
#   而它装的服务是 /etc/init.d/1panel-core。第一版只认我们自己那套，于是这句
#   必然失败 —— 于是安装器判"服务启动失败"并重试五次、最后报错退出，**而
#   进程其实好好地在跑、端口也在监听**。一次纯粹的假阴性。
sysv_def() {
  [ -x "/etc/init.d/$1" ]
}

need_def() {
  if sysv_def "$1"; then
    return 0
  fi
  if [ ! -e "$DEFS/$1" ]; then
    echo "✗ 没有这个服务: $1" >&2
    echo "  /usr/lib/yojigen-os/services/ 里的: $(ls "$DEFS" 2>/dev/null | tr '\n' ' ')" >&2
    echo "  /etc/init.d/ 里的: $(ls /etc/init.d 2>/dev/null | tr '\n' ' ')" >&2
    exit 1
  fi
}

# 真正执行一个动作 —— 两套都走这里
run_def() {
  name=$1
  act=$2
  if sysv_def "$name"; then
    "/etc/init.d/$name" "$act"
  else
    "$DEFS/$name" "$act"
  fi
}

# ── 参数顺序：两种都认（2026-10-22 真机上撞出来的）─────────────────────────
#
# **世界上那个 `service` 是 `service <名字> <动作>`**（Debian / RHEL 都这样）：
#
#     service 1panel-core status
#     service sshd restart
#
# 而我第一版写成了 `<动作> <名字>`（`service start docker`）—— 那是我自己顺手，
# 而它和真实世界相反。实测 1Panel 的安装脚本调 `service 1panel-core status`
# 判"服务起没起"，于是我们打印了用法并 exit 1 → 它认为服务失败了五次、报错
# 退出，**而进程好好地在跑**。
#
# ★ 所以：**认两种顺序**。判据是"第二个词是不是一个动作"——
#   是 → SysV 那种（名字在前）；否则按我自己那种（动作在前）。
ACTIONS='start|stop|restart|status|enable|disable|list'
if echo "$2" | grep -qE "^($ACTIONS)$"; then
  NAME=$1
  ACT=$2
else
  ACT=$1
  NAME=$2
fi

case "$ACT" in
  list|"")
    list_all ;;

  enable)
    [ -n "$NAME" ] || { usage; exit 1; }
    need_def "$NAME"
    mkdir -p "$SETS"
    ln -sf "$DEFS/$NAME" "$SETS/$NAME"
    echo "  已启用 ${NAME}（下次开机会自己起）" ;;

  disable)
    [ -n "$NAME" ] || { usage; exit 1; }
    if [ -e "$SETS/$NAME" ]; then
      rm -f "$SETS/$NAME"
      echo "  已停用 $NAME"
    else
      echo "  $NAME 本来就没启用"
    fi ;;

  start)
    [ -n "$NAME" ] || { usage; exit 1; }
    need_def "$NAME"
    run_def "$NAME" start ;;

  stop)
    [ -n "$NAME" ] || { usage; exit 1; }
    need_def "$NAME"
    run_def "$NAME" stop ;;

  restart)
    [ -n "$NAME" ] || { usage; exit 1; }
    need_def "$NAME"
    if sysv_def "$NAME"; then
      # SysV 的定义自己有 restart，原样交给它（它知道要不要等进程退出）
      "/etc/init.d/$NAME" restart
    else
      run_def "$NAME" stop
      sleep 1
      run_def "$NAME" start
    fi ;;

  status)
    [ -n "$NAME" ] || { usage; exit 1; }
    need_def "$NAME"
    if sysv_def "$NAME"; then
      # SysV 的定义自己有 status，而且它的返回码就是判据 —— 原样传出
      "/etc/init.d/$NAME" status
      exit $?
    fi
    if grep -q "^$NAME " /run/yojigen-os/services.log 2>/dev/null; then
      echo "  $NAME: 这次开机起过（见 /run/yojigen-os/services.log）"
    else
      echo "  $NAME: 这次开机没起过"
      exit 3
    fi ;;

  *)
    usage; exit 1 ;;
esac
