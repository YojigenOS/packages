#!/bin/sh
# SysV 的三个老接口：echo_success / echo_failure / log_error。
#
# ★ 它们本来是 RedHat 的 /etc/init.d/functions 里定义的【shell 函数】。而这样的
#   脚本常见得很：
#
#       [ $RETVAL -eq 0 ] && echo_success || echo_failure
#
#   —— 在 RedHat 系上那一行能跑，因为我们这里没有那个 functions 文件，
#   它会报 `echo_success: command not found`（实测 1Panel 的 .init 就撞了）。
#
# ★★ 而它们又叫不到 fs 里去：脚本没有 `source` 任何东西，所以只能【在 PATH 上】
#   真的有这三个命令。所以这里做一个多调用（multi-call）的脚本，装成三个名字。
#
# 用法：sysv-echo <success|failure|error> [文字]

# ★★ 分派按【被调用的名字】($0)，不是按 $1 —— multi-call 脚本的规矩
#   （busybox 那一套）。第一版按 $1 分派，于是 `echo_success`（无参数调用）
#   落进了 usage 分支、打印用法并 exit 2 —— 而 init 脚本里那一行是
#
#       [ $RETVAL -eq 0 ] && echo_success || echo_failure
#
#   于是"成功"和"失败"两条路都变成了一句用法提示。实测在 1Panel 的安装里
#   看到的就是「用法: /usr/sbin/echo_success ...」两行。
NAME=$(basename "$0")

case "$NAME" in
  echo_success)
    # 绿底 [ OK ] —— 而终端不支持颜色时就不带色
    if [ -t 1 ]; then printf '  \033[32m[ OK ]\033[0m\n'; else echo "  [ OK ]"; fi
    exit 0 ;;
  echo_failure)
    if [ -t 1 ]; then printf '  \033[31m[FAILED]\033[0m\n'; else echo "  [FAILED]"; fi
    exit 1 ;;
  log_error)
    echo "  [ERROR] $*" >&2
    exit 1 ;;
  *)
    echo "用法: echo_success | echo_failure | log_error [文字]" >&2
    exit 2 ;;
esac
