# atd 的认证栈
#
# ★★★ 这一份是照 **上游 at 源码里的 `pam.conf`** 翻译的（2026-10-26）：
#
#   上游（Debian 的 at 包把它改名成 /etc/pam.d/atd）：
#
#       @include common-auth
#       @include common-account
#       session    required   pam_loginuid.so
#       @include common-session-noninteractive
#       session    required   pam_limits.so
#       auth       required   pam_env.so user_readenv=1
#
#   而我们的命名是 RedHat 系的（`common-*` → `system-auth`），所以要翻译。
#
# ★★ 两处关键（我第一版漏了，任务因此执行不了）：
#
#   ① **必须有 `auth` 段** —— `atd` 在执行任务前调
#      `pam_setcred(pamh, PAM_ESTABLISH_CRED)`，而 `pam_setcred` 是遍历
#      **auth 类型**的模块。没有 auth 段 → PAM 报
#
#          Failure setting user credentials
#
#      然后任务被丢弃（atd.c 的 PAM_FAIL_CHECK）。
#
#   ② `pam_loginuid.so` 要留着 —— 它写 /proc/self/loginuid，
#      审计和 session 追踪靠它。
#
# ★ 而 `pam_limits.so` 在 system-auth 里已经有了（session 段），
#   这里不重复写。

auth        include       system-auth
auth        required      pam_env.so user_readenv=1
account     include       system-auth
session     required      pam_loginuid.so
session     include       system-auth
