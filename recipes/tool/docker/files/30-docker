#!/bin/sh
# 首启：起 dockerd。
#
# 由 /init 按 /usr/lib/yojigen-os/boot.d/ 下的名字顺序调用（30 在 sshd 的 20 之后）。
#
# 【为什么这里不该失败就拦住启动】
#
# 照 20-sshd 那条约定：启动脚本的责任是"让它起来"，不是"拦住启动"。起不来就
# 吵一声、继续跑 —— 一台进不去又起不来的机器比一台只起不来 docker 的机器糟得多。
#
# ── ★ 这里【没有】任何"按内核能力挑参数"的逻辑 ──────────────────────────────
#
# 2026-10-22 写过一版：没 overlayfs 就 `--storage-driver=vfs`、没 iptables 就
# `--iptables=false`、bridge 起不来就 `--bridge=none`。那是在真机上撞到三个内核
# 缺口之后写的，而它被**去掉了** —— 理由：
#
#   ① 那三个缺口是【内核配置】的事，已经补进 config.fragment；
#   ② 自适应参数会让"内核少了一样东西"变成**静默降级**：系统照样起、docker 照样
#      能用，只是慢（vfs）、没独立网络（bridge=none）。而没人会去查为什么。
#   ③ 一条为某个缺口写的降级分支，在缺口补上之后没人敢删 —— 于是它永远在那儿，
#      而将来内核回归时它会把问题藏起来。
#
# ★ 所以现在的规矩是：**dockerd 就按它该有的样子起**。缺什么它会自己报错，
#   而那正是我们想看见的。

[ -x /usr/bin/dockerd ] || { echo "  ⚠ dockerd 不在，跳过"; exit 0; }

mkdir -p /var/lib/docker /var/run /etc/docker

# 已经在跑就不重复起（/init 可能被重跑，或者有人手动起过）
if [ -S /var/run/docker.sock ]; then
  echo "  dockerd 已经在跑（/var/run/docker.sock 在）"
  exit 0
fi

echo "  起 dockerd…"
/usr/bin/dockerd >>/var/log/dockerd.log 2>&1 &

# 等 socket 建出来，最多 10 秒。**等到就报好消息，等不到也说清楚** ——
# 容器启动慢不代表系统有问题，而"没起来"必须能被看见。
i=0
while [ ! -S /var/run/docker.sock ] && [ "$i" -lt 20 ]; do
  i=$((i + 1))
  sleep 0.5 2>/dev/null || sleep 1
done

if [ -S /var/run/docker.sock ]; then
  echo "  ✓ dockerd 起来了"
else
  echo "  ⚠ dockerd 没起来 —— 见 /var/log/dockerd.log 的最后几行"
  tail -3 /var/log/dockerd.log 2>/dev/null | sed 's/^/     /'
fi
exit 0
