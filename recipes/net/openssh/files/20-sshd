#!/bin/sh
# 首启：生成 SSH 主机密钥（如果还没有），然后启动 sshd。
#
# 由 /init 按 /usr/lib/yojigen-os/boot.d/ 下的名字顺序调用。
#
# 【为什么不把主机密钥打进包】
#
# 见 ../spec.toml。一句话：带了就是所有机器共用同一把主机密钥，那等于没有。
# 所以每台机器第一次启动时自己生成——`ssh-keygen -A` 按 sshd_config 里出现的
# 类型逐个生成，只做一次（RSA 2048 要几百毫秒，之后不再有代价）。
#
# 【为什么这里不能失败**
#
# 启动脚本的责任是"让它起来"，不是"拦住启动"。起不来就吵一声，继续跑——
# 用户还能从串口/VNC 进去查。反过来说，如果这里 exit 1，整个系统就停在
# 一个连 shell 都没有的地方，那比 sshd 没起来严重得多。

set -u

# ── root 在 /etc/shadow 里是锁定的 ──────────────────────────────────────────
#
# ★ 这一条是真机上才暴露的：**sshd 对锁定账号拒绝一切认证，包括公钥。**
#
#   /etc/shadow 里那句注释说明了它的来历：
#
#       # 没有密码（!），root 只能通过提权或直接访问进入。
#       # 这是给【容器基础镜像】用的合理默认值；真机上【安装器会设置 root 密码】。
#       root:!::0:::::
#
#   而 DD 通道【没有安装器】——没有任何东西会去解开 root。于是：
#   系统起来了、sshd 起来了、公钥也在 /root/.ssh/authorized_keys 里，
#   但钥匙被拒：
#
#       root@…: Permission denied (publickey,password,keyboard-interactive)
#
#   而"连不上"在一台云主机上就是变砖：没有串口，VNC 又是另一回事。
#
# ★ 首启做，不在构建时做——理由和主机密钥一样：构建时做等于所有机器共用一个值。
#
# ★ 换成 `*` 而不是留空：留空表示"不需要密码"，而 * 表示"永远匹配不上"。
#   两者都不锁定，但只有后者是安全的。（下面另外把密码认证明确关掉，双保险。）
if [ "$(awk -F: '$1=="root"{print substr($2,1,1)}' /etc/shadow 2>/dev/null)" = "!" ]; then
    echo "  解开 root（/etc/shadow 里是锁定的，sshd 会因此拒绝公钥）…"
    awk -F: 'BEGIN{OFS=":"} $1=="root" && substr($2,1,1)=="!" {$2="*"} {print}' \
        /etc/shadow > /etc/shadow.new && cat /etc/shadow.new > /etc/shadow && rm -f /etc/shadow.new
    chmod 600 /etc/shadow
fi

# ── 主机密钥 ────────────────────────────────────────────────────────────────
if ! ls /etc/ssh/ssh_host_*_key >/dev/null 2>&1; then
    echo "  生成 SSH 主机密钥（第一次启动，之后不再做）…"
    ssh-keygen -A || echo "  ⚠ 主机密钥生成失败，sshd 起不来"
fi

# ── 启动 ────────────────────────────────────────────────────────────────────
if [ ! -x /usr/sbin/sshd ]; then
    echo "  ⚠ 找不到 /usr/sbin/sshd"
    exit 0
fi

# sshd 的权限分离用两个目录：
#
#   /run/sshd    运行时目录（Debian 那边由 systemd 的 RuntimeDirectory 提供，
#                我们没有 systemd，所以自己建）
#   /var/empty   降权后的沙箱。**sshd 对它有硬要求**：
#
#                    /var/empty must be owned by root and not group or world-writable.
#
#               包里建的时候是 711 root（recipe 里写着），但**实测在真机上它会
#                不对** —— 那就起不来 sshd，而表现是"钥匙被拒"，看着像密钥问题。
#
#             ★ 所以钩子自己兜一次：**它该保证自己的前提，而不是信任上游那一步
#               在每一层搬运之后还成立**。（cpio 那条注释说的是同一件事：
#               "静默漏掉一个东西，表现是发布时报一个指不到这里的错"。）
install -d -m 711 -o root -g root /var/empty
mkdir -p /run/sshd

# sshd 自己会 daemon 化并 fork，所以这里不加 &。
if /usr/sbin/sshd; then
    echo "  sshd 已启动（端口 22，只认公钥）"
else
    echo "  ⚠ sshd 启动失败——用 /usr/sbin/sshd -t 看配置哪里不对"
fi
