#!/bin/sh
# 保证 /root/.ssh/authorized_keys 存在、且属主和权限是 sshd 要的那样。
#
# 【为什么需要一个小工具，而不是把这段写在三个地方】
#
# 同一件事有三个触发点，而它们都得做对：
#
#     post-install    装完之后
#     post-upgrade    升级之后   ← ★ 而这一步是必需的，见下
#     boot.d/20-sshd  开机时
#
# 写三份就会出现"改了一处忘了另一处"——而这正是这一格反复出问题的形状。
# 所以逻辑只写这一份，三个入口都调它。
#
# 【而升级那一格为什么必需】
#
# `/root/.ssh/authorized_keys` 原来是【归包所有】的，而那样每次
# `apk upgrade openssh` 都会用包里那份替换盘上那份 —— 用户往里加过的东西
# 就没了。所以从 r6 起改成【不归包所有】。
#
# 而改完之后多了一个新问题：升级时 apk 会按规矩删掉"旧版本有、新版本没有"
# 的文件 —— 也就是它。实测过：
#
#     装 r4        →  /root/.ssh/authorized_keys 在
#     升级到 r6    →  /root 下【空了】
#
# 而那个文件不在 = 谁也进不去（要等下次开机才被钩子补回来）。
# **post-upgrade 就是在"装完"和"下次开机"之间补上这一格的。**

set -u

TEMPLATE=/usr/share/yojigen-os/ssh/authorized_keys.default
TARGET=/root/.ssh/authorized_keys

# 已经有了就不动它 —— **盘上那份是这台机器的东西，不是包的**。
# 用户往里加过钥匙，就不该被碰。
if [ -s "$TARGET" ]; then
    # 只管属主和权限（sshd 的 StrictModes 会一路查）。改属主是安全的。
    chown root:root "$TARGET" 2>/dev/null || true
    chmod 600 "$TARGET" 2>/dev/null || true
    exit 0
fi

install -d -m 700 -o root -g root /root/.ssh 2>/dev/null \
    || { mkdir -p /root/.ssh 2>/dev/null; chmod 700 /root/.ssh 2>/dev/null; }

if [ ! -f "$TEMPLATE" ]; then
    echo "  ⚠ 没有模板 $TEMPLATE —— 只能用控制台进去了"
    exit 1
fi

# ★★ 而【成功的信息必须是真的】—— 这一版第一稿在这里说了谎。
#
#   第一稿是这样写的：
#
#       install -m 600 … "$TEMPLATE" "$TARGET" 2>/dev/null \
#           || { cp … && chmod …; }
#       echo "  ✓ 已铺上默认公钥"                 ← ★ 这句不在任何 && 链里
#
#   于是 `install` 失败、fallback 也失败（实测：那个 root 里没有
#   install/cp/chmod），而它照样报"✓ 已铺上"。**一个说谎的成功信息比没有
#   信息更糟** —— 它会让人不再去看那件事。
#
#   所以现在每一句"成了"都挂在【真的成没成】上。
ok=""
if install -m 600 -o root -g root "$TEMPLATE" "$TARGET" 2>/dev/null; then
    ok=1
elif cp "$TEMPLATE" "$TARGET" 2>/dev/null; then
    chmod 600 "$TARGET" 2>/dev/null || true
    ok=1
fi

# ★ 属主单独再设一次 —— 上面那两条路都可能没设上：
#     · install 的 -o/-g 在非 root 时是【静默忽略】的
#     · cp 那条根本没有 chown
#   而 sshd 的 StrictModes 查属主，查不到就拒绝 —— 实测撞过两次。
chown root:root "$TARGET" 2>/dev/null || true
chown root:root /root/.ssh 2>/dev/null || true

if [ -n "$ok" ] && [ -s "$TARGET" ]; then
    echo "  ✓ 已铺上默认公钥（$TARGET 原来不在）"
else
    echo "  ✗ 铺默认公钥【失败】—— $TARGET 还是不在，只能用控制台进去"
    echo "      （模板在 ${TEMPLATE}。检查 install/cp/chmod 在不在，以及 /root 能不能写。）"
    exit 1
fi

exit 0
