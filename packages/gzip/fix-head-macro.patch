Description: Rename the `head` macro to `gz_head` to fix the AArch64 build
 On AArch64 the kernel header asm/sigcontext.h declares structs with a field
 named `head`, while gzip.h defines `head` as an object-like macro. gzip 1.15
 added `#include <signal.h>` to gzip.c, which transitively includes that
 header, so the macro now mangles the struct declaration and the build fails
 with "gzip.h:120:21: error: expected ')' before '+' token".
 .
 Renaming the macro — rather than reordering the includes as upstream did —
 keeps the fix correct regardless of include order, including in deflate.c
 and unlzh.c which also expand it.
Origin: vendor
Forwarded: upstream. The maintainer fixed it by moving the gzip.h include to
 the end of gzip.c's include block; that fix is not in a release yet (1.15 is
 still current). Drop this patch once a release contains it.
Last-Update: 2026-10-10

diff -ruN a/deflate.c b/deflate.c
--- a/deflate.c	2026-07-26 06:39:51
+++ b/deflate.c	2026-10-10 15:11:41
@@ -290,8 +290,8 @@
  */
 #define INSERT_STRING(s, match_head) \
    (UPDATE_HASH(ins_h, window[(s) + MIN_MATCH-1]), \
-    prev[(s) & WMASK] = match_head = head[ins_h], \
-    head[ins_h] = (s))
+    prev[(s) & WMASK] = match_head = gz_head[ins_h], \
+    gz_head[ins_h] = (s))
 
 /* ===========================================================================
  * Initialize the "longest match" routines for a new file
@@ -306,9 +306,9 @@
 
     /* Initialize the hash table. */
 #if defined MAXSEG_64K && HASH_BITS == 15
-    for (j = 0;  j < HASH_SIZE; j++) head[j] = NIL;
+    for (j = 0;  j < HASH_SIZE; j++) gz_head[j] = NIL;
 #else
-    memzero((char*)head, HASH_SIZE*sizeof(*head));
+    memzero((char*)gz_head, HASH_SIZE*sizeof(*gz_head));
 #endif
     /* prev will be initialized on the fly */
 
@@ -555,8 +555,8 @@
         block_start -= (long) WSIZE;
 
         for (n = 0; n < HASH_SIZE; n++) {
-            m = head[n];
-            head[n] = (Pos)(m >= WSIZE ? m-WSIZE : NIL);
+            m = gz_head[n];
+            gz_head[n] = (Pos)(m >= WSIZE ? m-WSIZE : NIL);
         }
         for (n = 0; n < WSIZE; n++) {
             m = prev[n];
diff -ruN a/gzip.h b/gzip.h
--- a/gzip.h	2026-09-19 14:35:07
+++ b/gzip.h	2026-10-10 15:11:41
@@ -117,11 +117,11 @@
 #define tab_suffix window
 #ifndef MAXSEG_64K
 #  define tab_prefix prev    /* hash link (see deflate.c) */
-#  define head (prev+WSIZE)  /* hash head (see deflate.c) */
+#  define gz_head (prev+WSIZE)  /* hash head (see deflate.c) */
    EXTERN(ush, tab_prefix);  /* prefix code (see unlzw.c) */
 #else
 #  define tab_prefix0 prev
-#  define head tab_prefix1
+#  define gz_head tab_prefix1
    EXTERN(ush, tab_prefix0); /* prefix for even codes */
    EXTERN(ush, tab_prefix1); /* prefix for odd  codes */
 #endif
