# YojigenOS 的内核配置片段
#
# 【为什么要一个片段而不是一份完整 .config】
#
# 完整 .config 是几万个选项的合影，它和内核版本绑死：换个版本就有选项消失、
# 有新选项没有默认值，于是 olddefconfig 会静默改掉一堆东西——而"静默改掉"
# 正是最难查的那种问题。
#
# 片段只写【我们真正在乎的】那几项，其余交给 defconfig。这样升级内核时，
# 消失的选项会报出来，而不是被悄悄忽略。
#
# 用法：make defconfig 之后再 merge_config.sh 合并进来，最后 olddefconfig。

# ── 控制台 ────────────────────────────────────────────────────────────
# QEMU 的 virt 机器用 PL011 串口。没有它，开机后一个字都看不到——
# 而看不到输出就没法调试。
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y

# ── virtio ───────────────────────────────────────────────────────────
# virt 机器上的磁盘、网卡、共享目录全是 virtio 设备。
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_PCI=y

# ── initramfs ────────────────────────────────────────────────────────
# 第一阶段的启动方式就是「内核 + initramfs」，所以这个必须有。
# 加上 gzip 解压支持——cpio.gz 要能解开。
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

# ── 文件系统 ─────────────────────────────────────────────────────────
# devtmpfs 由内核自动挂载（_MOUNT=y），这样 /init 一跑起来 /dev 就是齐的，
# 不需要用户空间再去创建设备节点。
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
# ext4 是给后面的磁盘镜像留的，现在用不上，但装了不亏。
CONFIG_EXT4_FS=y

# ── 关于证书那一套（CONFIG_SYSTEM_TRUSTED_KEYRING）────────────────────
#
# 第三个实测撞出来的坑，但结论和前两个（flex、bc）不一样。
#
# 症状是缺 openssl：
#
#     certs/extract-cert.c:21:10: fatal error: openssl/bio.h: No such file
#
# 病因在 certs/Makefile 第一行：
#
#     obj-$(CONFIG_SYSTEM_TRUSTED_KEYRING) += system_keyring.o system_certificates.o
#
# 而 system_certificates.o 依赖 x509_certificate_list，后者依赖 extract-cert，
# 那个小程序用 openssl 读 X.509 证书。
#
# 【试过在这里关掉它，关不掉】Kconfig 的 select 会覆盖配置文件里的显式值：
#
#     SYSTEM_DATA_VERIFICATION=y  ──select──▶  SYSTEM_TRUSTED_KEYRING=y
#
# 而 SYSTEM_DATA_VERIFICATION 自己被四个地方 select（dm-verity、ubifs、
# fs-verity、module-sig 的签名子项），一个个关下去是打地鼠——实测关掉那四个
# 之后 SYSTEM_TRUSTED_KEYRING 依然是 y。
#
# 【所以改成加 openssl 包】见 packages/lib/openssl/spec.toml。这是对的选择，
# 理由不是「绕不过去」，而是本来就要它：python3 的 https、curl、git、以及
# 决策记录 0006 说的包签名，全都挂在 openssl 上。为了绕开它去砍内核的完整性
# 校验（固件验签、fs-verity、dm-verity 都在那条链上）才是亏的。
#
# 这个片段因此不再尝试关它——留着这几行注释，是为了让下一个人不用再查一遍
# 「为什么这里没有关掉证书的选项」。

# ── 瘦身 ─────────────────────────────────────────────────────────────
# 不编模块：第一阶段全部内建，省掉「模块放哪、谁来加载」这一整类问题。
CONFIG_MODULES=n

# 【不启用】的东西，以及为什么：
#
#   CONFIG_DEBUG_INFO_BTF     需要 pahole（我们没有）
#   CONFIG_MODULE_SIG         需要 openssl（我们没有）
#   CONFIG_DEBUG_INFO         体积会涨到几百 MB，而且现在不需要调试符号
CONFIG_DEBUG_INFO_NONE=y
